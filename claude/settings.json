{
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.md) out=$(NODE_PATH=\"$HOME/.textlint/node_modules\" \"$HOME/Library/pnpm/bin/textlint\" -c \"$HOME/.textlintrc.json\" \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; };; esac",
            "timeout": 30,
            "statusMessage": "textlintを実行中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/kohei.ayamoto/.claude/hooks/note-added-comments.py'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "episodic-memory@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "language": "日本語",
  "effortLevel": "high",
  "advisorModel": "opus",
  "theme": "dark",
  "attributes": {
    "sessionUrl": false
  }
}
